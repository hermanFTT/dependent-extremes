# -----------------------------------------------------------------------------
# hpd_from_grid()
# HPD interval from a posterior density evaluated on a grid, via HDInterval::hdi
# applied to a "density"-classed object (same pattern as used interactively).
# Returns c(lower, upper); c(NA, NA) if the density is degenerate.
# -----------------------------------------------------------------------------
hpd_from_grid <- function(x, dens, cred_mass = 0.95) {

  ok <- is.finite(x) & is.finite(dens) & dens >= 0
  if (sum(ok) < 3L) return(c(NA_real_, NA_real_))
  x <- x[ok]; dens <- dens[ok]

  ord      <- order(x)
  dens_obj <- structure(list(x = x[ord], y = dens[ord]), class = "density")

  out <- tryCatch(HDInterval::hdi(dens_obj, credMass = cred_mass),
                  error = function(e) c(NA_real_, NA_real_))
  as.numeric(out[1:2])
}


# -----------------------------------------------------------------------------
# eti_from_grid()
# Equal-tailed credible interval by resampling the posterior grid with the
# profile-posterior weights w_theta, then taking quantile() at alpha/2, 1-alpha/2.
# Grid and w_theta are both in theta-order (xp_grid is truncated from the start
# in gpdfit_dens), so w_theta[1:length(grid)] is aligned with grid.
# -----------------------------------------------------------------------------
eti_from_grid <- function(grid, w_theta, cred_mass = 0.95, n_draws = 10000L) {

  if (length(grid) < 3L) return(c(NA_real_, NA_real_))

  prob <- w_theta[seq_along(grid)]
  ok   <- is.finite(grid) & is.finite(prob) & prob >= 0
  if (sum(ok) < 3L || sum(prob[ok]) <= 0) return(c(NA_real_, NA_real_))

  draws <- sample(grid[ok], size = n_draws, replace = TRUE, prob = prob[ok])
  alpha <- 1 - cred_mass
  as.numeric(stats::quantile(draws, probs = c(alpha / 2, 1 - alpha / 2)))
}


# -----------------------------------------------------------------------------
# cred_interval()
# Dispatcher: "hpd" (highest posterior density, via HDInterval on the density)
# or "eti" (equal-tailed, via resampling + quantile).
# -----------------------------------------------------------------------------
cred_interval <- function(grid, dens, w_theta, cred_mass = 0.95,
                          type = c("hpd", "eti"), n_draws = 10000L) {
  type <- match.arg(type)
  if (type == "hpd") hpd_from_grid(grid, dens, cred_mass)
  else               eti_from_grid(grid, w_theta, cred_mass, n_draws)
}


# =============================================================================
# SIMULATING TEMPORALLY DEPENDENT EXTREMES
#
# Two generators for stationary series with GPD(mu, sigma, k) margins and
# temporal dependence in the extremes:
#
#   sim_ar1_gpd()     Gaussian AR(1) copula. Simple, but ASYMPTOTICALLY
#                     INDEPENDENT: extremal clustering dies out as the
#                     threshold rises, so it understates real dependence.
#
#   sim_markov_gpd()  Stationary first-order Markov chain whose successive
#                     pairs (X_i, X_i+1) follow a bivariate extreme value
#                     distribution -- Fawcett & Walshaw (2007), Environmetrics
#                     18:173-188, Section 4.1. ASYMPTOTICALLY DEPENDENT (for
#                     logistic alpha < 1), so clusters persist at arbitrarily
#                     high thresholds. This is the paper's design.
#
# Paper's scheme (Section 4.1.3): simulate x1 from standard Frechet, then
# repeatedly form and sample the conditional X_i+1 | X_i from the chosen
# bivariate EV model, then transform the WHOLE series to GPD margins.
# POT::simmc() implements the chain; margins = "uniform" lets us apply
# qgeneralized_pareto() directly (same monotone marginal transform).
#
# Both return a raw series (NOT thresholded), ready for weights_fun(),
# geom_weighted_gpdfit(), sim_compare(), ...
# =============================================================================


# -----------------------------------------------------------------------------
# sim_ar1_gpd()
# Gaussian AR(1) copula with GPD margins (the original generator).
#   phi   AR(1) coefficient in (-1, 1); larger = stronger dependence.
# -----------------------------------------------------------------------------
sim_ar1_gpd <- function(n, phi = 0.9, mu = 0, sigma = 1, k = 0) {
  z <- as.numeric(arima.sim(n = n, list(ar = phi), sd = sqrt(1 - phi^2)))
  qgeneralized_pareto(pnorm(z), mu = mu, sigma = sigma, k = k)
}



#**the Gaussian AR(1) copula is asymptotically independent** — its extremal clustering decays
#as the threshold rises — whereas the logistic model with α<1 is **asymptotically dependent**,
#so clusters persist at any threshold.

# -----------------------------------------------------------------------------
# sim_markov_gpd()
# First-order Markov chain of bivariate extreme value type, GPD margins.
#
#   model  Dependence model for the bivariate EV distribution:
#            "log"   symmetric logistic     alpha in (0,1]
#                    alpha -> 1 : independence;  alpha -> 0 : full dependence
#            "nlog"  negative logistic      alpha > 0
#                    alpha -> 0 : independence;  alpha -> Inf: full dependence
#            "mix"   mixed model            alpha in [0,1]
#                    alpha -> 0 : independence
#            "alog", "anlog", "amix" -- asymmetric versions; these need the
#                    extra coefficients asCoef / asCoef1 / asCoef2, passed via ...
#   alpha  Dependence parameter (see above -- NOTE the direction differs
#          between "log" and "nlog").
#   asCoef, asCoef1, asCoef2
#          Asymmetry coefficients, only used by "alog"/"anlog"/"amix".
#   max_try Number of redraws allowed if POT::simmc() fails numerically.
#
# ROBUSTNESS
#   POT::simmc() inverts the conditional CDF X_i+1 | X_i with a bracketing
#   root-finder written in C. For unlucky uniform draws the bracket can fail,
#   raising "values at end points are not of opposite sign" (that string lives
#   in POT.so; R attributes it to the enclosing POT::simmc() call). The failure
#   depends only on the random draws, so we simply redraw the series.
#
# Requires the POT package.
# -----------------------------------------------------------------------------
sim_markov_gpd <- function(n, alpha = 0.5,
                           model = c("log", "nlog", "mix",
                                     "alog", "anlog", "amix"),
                           mu = 0, sigma = 1, k = 0,
                           asCoef = 0.1, asCoef1 = 0.9, asCoef2 = 0.9,
                           max_try = 20L, ...) {

  model <- match.arg(model)
  stopifnot(requireNamespace("POT", quietly = TRUE))

  # first-order Markov chain with uniform margins (retry on numerical failure)
  uu <- NULL
  for (i in seq_len(max_try)) {
    uu <- tryCatch(
      POT::simmc(n, alpha = alpha, model = model, margins = "uniform",
                 asCoef = asCoef, asCoef1 = asCoef1, asCoef2 = asCoef2, ...),
      error = function(e) {
        # re-raise anything that is not the transient root-finding failure
        if (!grepl("opposite sign", conditionMessage(e))) stop(e)
        NULL
      })
    # a valid draw is finite and strictly inside (0, 1)
    if (!is.null(uu) && all(is.finite(uu)) && all(uu > 0 & uu < 1)) break
    uu <- NULL
  }
  if (is.null(uu))
    stop(sprintf("POT::simmc() failed %d consecutive times (model = '%s', alpha = %g, n = %d).",
                 max_try, model, alpha, n))

  # transform margins to GPD (paper: Frechet -> GPD; same monotone transform)
  qgeneralized_pareto(as.numeric(uu), mu = mu, sigma = sigma, k = k)
}


# -----------------------------------------------------------------------------
# sim_series()
# Dispatcher used by sim_compare(): dep = "ar1" or "markov".
# -----------------------------------------------------------------------------
sim_series <- function(n, dep = c("ar1", "markov"),
                       phi = 0.9, alpha = 0.5, model = "log",
                       mu = 0, sigma = 1, k = 0, ...) {
  dep <- match.arg(dep)
  if (dep == "ar1")
    sim_ar1_gpd(n, phi = phi, mu = mu, sigma = sigma, k = k)
  else
    sim_markov_gpd(n, alpha = alpha, model = model,
                   mu = mu, sigma = sigma, k = k, ...)
}


# -----------------------------------------------------------------------------
# theta_runs()
# Runs estimator of the extremal index: #clusters / #exceedances.
# Handy for matching dependence strength across generators.
# NB: downward biased for small r -- for iid data at u = 95% with r = 10 it
#     returns ~0.6, not 1, because nearby exceedances merge by chance.
# -----------------------------------------------------------------------------
theta_runs <- function(x, u = stats::quantile(x, 0.95), r = 10) {
  idx <- which(x > u)
  if (!length(idx)) return(NA_real_)
  max(cumsum(c(TRUE, diff(idx) >= r + 1L))) / length(idx)
}


# =============================================================================
# sim_compare()
#
# Monte-Carlo comparison of the three estimation procedures on AR(1)-dependent
# data with GPD margins. For each replicate the point estimates k_hat,
# sigma_hat and xp_hat are recorded, then summarised by bias / SD / RMSE.
#
#   1. Weighted GPD        — geom_weighted_gpdfit_dens() with CRPS-optimal q
#   2. Cluster maxima/POT  — gpdfit_dens() with q = 0
#   3. Conventional        — gpdfit_dens() with r = 0 (equal weights)
#
# GROUND TRUTH
#   k_true     = k
#   sigma_true = sigma + k*u     (GPD scale *above* the threshold u)
#   xp_true    = qgeneralized_pareto(1 - 1/m, sigma = sigma, k = k)
#
# ARGUMENTS
#   S          Integer. Number of Monte-Carlo replicates.
#   n          Integer. Series length per replicate.
#   dep        "ar1"    — Gaussian AR(1) copula (asymptotically independent), or
#              "markov" — first-order Markov chain of bivariate extreme value
#                         type (asymptotically dependent; Fawcett & Walshaw
#                         2007, Section 4.1).
#   phi        Numeric. AR(1) coefficient, used when dep = "ar1".
#   alpha      Numeric. Dependence parameter, used when dep = "markov".
#              "log":  alpha in (0,1], 1 = independence, ->0 = full dependence
#              "nlog": alpha > 0,      ->0 = independence, large = full dep.
#   dep_model  Bivariate EV model when dep = "markov": "log", "nlog", "mix", ...
#   k, sigma   Numeric. True GPD margin parameters.
#   p_thresh   Numeric in (0,1). Threshold probability level.
#   m          Integer. Return period for xp (P(X > xp) = 1/m).
#   run        Integer. Run-length for cluster detection.
#   threshold  "theoretical" (fixed u, fixed truth) or "empirical" (u = sample
#              quantile, so sigma_true varies per replicate).
#   coverage   Logical. If TRUE, also compute the empirical coverage of the
#              credible interval for k and xp. Requires density = TRUE.
#   cred_mass  Numeric in (0,1). Credible mass of the interval.
#   interval   "hpd" — highest posterior density (HDInterval::hdi on the
#                      posterior density grid), or
#              "eti" — equal-tailed (resample the grid with weights w_theta,
#                      then quantile() at alpha/2 and 1 - alpha/2).
#   n_draws    Integer. Number of resamples used when interval = "eti".
#   verbose    Logical. Print progress.
#
# VALUE
#   list(estimates = <S*3 x 6 data.frame>, summary = <data.frame>, truth = list)
# =============================================================================

sim_compare <- function(S = 1000, n = 2000,
                        dep          = c("ar1", "markov"),
                        phi          = 0.95,
                        alpha        = 0.5,
                        dep_model    = "log",
                        k = 0.35, sigma = 1,
                        p_thresh     = 0.95,
                        m            = 5000,
                        run          = NULL,
                        n_grid       = 50,
                        min_grid_pts = 100,
                        wip          = FALSE,
                        threshold    = c("theoretical", "empirical"),
                        coverage     = TRUE,
                        cred_mass    = 0.95,
                        interval     = c("hpd", "eti"),
                        n_draws      = 10000L,
                        seed         = 1,
                        verbose      = TRUE) {

  threshold <- match.arg(threshold)
  interval  <- match.arg(interval)
  dep       <- match.arg(dep)
  if (dep == "markov")
    stopifnot(requireNamespace("POT", quietly = TRUE))
  if (coverage && interval == "hpd")
    stopifnot(requireNamespace("HDInterval", quietly = TRUE))
  set.seed(seed)

  procs <- c("Weighted GPD", "Cluster maxima (POT)", "Conventional")

  # --- fixed ground truth ---------------------------------------------------
  xp_true <- qgeneralized_pareto(1 - 1 / m, mu = 0, sigma = sigma, k = k)
  u_fixed <- qgeneralized_pareto(p_thresh,  mu = 0, sigma = sigma, k = k)

  # storage: S x 3 procedures x 7 slots
  slots <- c("k", "sigma", "xp", "hit_k", "hit_xp", "wid_k", "wid_xp")
  est <- array(NA_real_, dim = c(S, 3L, length(slots)),
               dimnames = list(NULL, procs, slots))
  sig_true_rep <- numeric(S)
  run_rep      <- integer(S)      # run length actually used per replicate

  # extract point estimates + (optionally) HPD coverage from one fit
  collect <- function(f) {
    out <- rep(NA_real_, length(slots))
    out[1:3] <- c(f$k, f$sigma, f$xp)
    if (coverage) {
      hk <- cred_interval(f$k_grid,  f$k_dens,  f$w_theta,
                          cred_mass, interval, n_draws)
      hx <- cred_interval(f$xp_grid, f$xp_dens, f$w_theta,
                          cred_mass, interval, n_draws)
      out[4] <- as.numeric(k       >= hk[1L] & k       <= hk[2L])
      out[5] <- as.numeric(xp_true >= hx[1L] & xp_true <= hx[2L])
      out[6] <- hk[2L] - hk[1L]
      out[7] <- hx[2L] - hx[1L]
    }
    out
  }
  n_slot <- length(slots)

  tick <- max(1L, floor(S / 10))

  for (s in seq_len(S)) {

    # --- simulate a dependent series with GPD margins -----------------------
    x <- sim_series(n, dep = dep, phi = phi, alpha = alpha, model = dep_model,
                    mu = 0, sigma = sigma, k = k)

    u <- if (threshold == "theoretical") u_fixed
         else as.numeric(quantile(x, probs = p_thresh))

    sig_true_rep[s] <- sigma + k * u          # true scale above u

    rp <- list(u = u, m = m, p_u = mean(x > u))

    # run length: automatic (per replicate) unless the user fixed one
    run_s       <- if (is.null(run)) auto_run_length(x, u) else run
    run_rep[s]  <- run_s

    # --- 1. weighted GPD (CRPS-optimal q) ----------------------------------
    est[s, 1L, ] <- tryCatch({
      f <- geom_weighted_gpdfit_dens(x, u, run_s,
                                     n_grid       = n_grid,
                                     min_grid_pts = min_grid_pts,
                                     wip          = wip,
                                     sort_x       = FALSE,
                                     rparams      = rp,
                                     density      = coverage)
      collect(f)
    }, error = function(e) rep(NA_real_, n_slot))

    # --- 2. cluster maxima / POT (q = 0) -----------------------------------
    est[s, 2L, ] <- tryCatch({
      w <- weights_fun(x, u, r = run_s, q = 0)
      f <- gpdfit_dens(w$excesses, wip = wip, min_grid_pts = min_grid_pts,
                       sort_x = TRUE, weights = w$weights,
                       rparams = rp, density = coverage)
      collect(f)
    }, error = function(e) rep(NA_real_, n_slot))

    # --- 3. conventional (r = 0, equal weights) ----------------------------
    est[s, 3L, ] <- tryCatch({
      w <- weights_fun(x, u, r = 0)
      f <- gpdfit_dens(w$excesses, wip = wip, min_grid_pts = min_grid_pts,
                       sort_x = TRUE, weights = w$weights,
                       rparams = rp, density = coverage)
      collect(f)
    }, error = function(e) rep(NA_real_, n_slot))

    if (verbose && (s %% tick == 0L))
      cat(sprintf("  ... %d / %d replicates (%.0f%%)\n", s, S, 100 * s / S))
  }

  # --- tidy long data.frame of raw estimates -------------------------------
  estimates <- do.call(rbind, lapply(seq_along(procs), function(j) {
    data.frame(rep       = seq_len(S),
               procedure = procs[j],
               k         = est[, j, "k"],
               sigma     = est[, j, "sigma"],
               xp        = est[, j, "xp"])
  }))
  estimates$procedure <- factor(estimates$procedure, levels = procs)

  # --- summary: bias / SD / RMSE -------------------------------------------
  truth_vec <- list(k = rep(k, S), sigma = sig_true_rep, xp = rep(xp_true, S))

  summ <- do.call(rbind, lapply(c("k", "sigma", "xp"), function(par) {
    do.call(rbind, lapply(seq_along(procs), function(j) {
      e  <- est[, j, par]
      tv <- truth_vec[[par]]
      ok <- is.finite(e)
      e  <- e[ok]; tv <- tv[ok]
      d  <- e - tv

      # HPD coverage (only for k and xp; sigma has no posterior density here)
      cov_p <- NA_real_; cov_w <- NA_real_
      if (coverage && par %in% c("k", "xp")) {
        hit   <- est[, j, if (par == "k") "hit_k" else "hit_xp"]
        wid   <- est[, j, if (par == "k") "wid_k" else "wid_xp"]
        cov_p <- mean(hit, na.rm = TRUE)
       # cov_w <- mean(wid, na.rm = TRUE)
      }

      data.frame(
        parameter    = par,
        procedure    = procs[j],
        truth        = mean(tv),
        mean_est     = mean(e),
        bias         = mean(d),
        sd           = stats::sd(e),
        rmse         = sqrt(mean(d^2)),
        mae          = mean(abs(d)),
        coverage     = cov_p,
        n_ok         = length(e)
      )
    }))
  }))
  rownames(summ) <- NULL
  summ$procedure <- factor(summ$procedure, levels = procs)

  dep_lab <- if (dep == "ar1") sprintf("AR(1) phi = %g", phi)
             else              sprintf("Markov %s alpha = %g", dep_model, alpha)
  run_lab <- if (is.null(run))
               sprintf("run = auto (mean %.1f, range %d-%d)",
                       mean(run_rep), min(run_rep), max(run_rep))
             else sprintf("run = %d", run)

  if (verbose) {
    cat("\n--- Monte-Carlo summary (S =", S, ", n =", n,
        ",", dep_lab, ",", run_lab, ", threshold =", threshold,
        ", interval =", toupper(interval), ") ---\n")
    print(summ, digits = 4)
  }

  list(estimates = estimates,
       summary   = summ,
       interval  = interval,
       run       = run_rep,
       dep       = list(type = dep, phi = phi, alpha = alpha,
                        model = dep_model, label = dep_lab),
       truth     = list(k = k, sigma = mean(sig_true_rep), xp = xp_true,
                        u = if (threshold == "theoretical") u_fixed else NA))
}


# -----------------------------------------------------------------------------
# plot_sim_compare()
# Boxplots of the S estimates per procedure, one facet per parameter, with a
# dashed line at the true value.
# -----------------------------------------------------------------------------
plot_sim_compare <- function(sim, trim = 0.01) {

  stopifnot(requireNamespace("ggplot2", quietly = TRUE))

  long <- do.call(rbind, lapply(c("k", "sigma", "xp"), function(par) {
    data.frame(procedure = sim$estimates$procedure,
               parameter = par,
               value     = sim$estimates[[par]])
  }))
  long <- long[is.finite(long$value), ]

  # clip extreme outliers for readability (xp can be very heavy-tailed)
  if (trim > 0) {
    long <- do.call(rbind, lapply(split(long, long$parameter), function(d) {
      qs <- stats::quantile(d$value, c(trim, 1 - trim), na.rm = TRUE)
      d[d$value >= qs[1] & d$value <= qs[2], ]
    }))
  }

  truth_df <- data.frame(parameter = c("k", "sigma", "xp"),
                         value     = c(sim$truth$k, sim$truth$sigma, sim$truth$xp))

  pal <- c("Weighted GPD"         = "#2166AC",
           "Cluster maxima (POT)" = "#D6604D",
           "Conventional"         = "#4DAC26")

  ggplot2::ggplot(long, ggplot2::aes(x = procedure, y = value, fill = procedure)) +
    ggplot2::geom_boxplot(outlier.size = 0.5, alpha = 0.75, width = 0.6) +
    ggplot2::geom_hline(data = truth_df,
                        ggplot2::aes(yintercept = value),
                        linetype = "dashed", colour = "grey25") +
    ggplot2::facet_wrap(~ parameter, scales = "free_y",
                        labeller = ggplot2::labeller(
                          parameter = c(k = "shape  k",
                                        sigma = "scale  sigma",
                                        xp = "return level  x_p"))) +
    ggplot2::scale_fill_manual(values = pal, guide = "none") +
    ggplot2::labs(title = "Monte-Carlo comparison of GPD fitting procedures",
                  subtitle = "dashed line = true value",
                  x = NULL, y = "estimate") +
    ggplot2::theme_bw(base_size = 12) +
    ggplot2::theme(axis.text.x = ggplot2::element_text(angle = 20, hjust = 1),
                   panel.grid.minor = ggplot2::element_blank())
}


