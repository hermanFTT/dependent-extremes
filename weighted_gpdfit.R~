# =============================================================================
# weighted_gpdfit.R
#
# PURPOSE
# -------
# Fit a Generalized Pareto Distribution (GPD) to temporally dependent
# threshold exceedances using cluster-aware geometric weights.
# Temporal clusters of exceedances above a high threshold u are identified by a
# run-length parameter; within each cluster, weights decay geometrically
# from the largest to the smallest excess (rate q). The optimal q is chosen
# by minimising the posterior expected CRPS score over a grid, yielding a single
# call to `geom_weighted_gpdfit()`.
#
# COMMON ARGUMENTS
# ----------------
#   x            Numeric vector. Raw time series (NOT pre-thresholded).
#   u            Numeric scalar. Threshold/cutoff; only x > u contribute.
#   r / run      Integer. Run-length for cluster detection: consecutive
#                exceedances with gaps < r+1 belong to the same cluster.
#   q            Numeric in [0,1]. Geometric decay rate for within-cluster
#                weights. q=0 → all weight on the cluster maximum (POT);
#                q→1 → near-equal weights within a cluster.
#   n_grid       Integer. Number of q values scanned when selecting q_opt.
# =============================================================================


# -----------------------------------------------------------------------------
# geom_weighted_gpdfit()
# Main entry point. Finds the optimal geometric decay q, then fits the GPD
# on the corresponding weighted excesses. Returns list(k, sigma).
# run = NULL (default) → run length chosen automatically by auto_run_length()
# (Ferro-Segers 2003); pass an integer to override.
# -----------------------------------------------------------------------------

geom_weighted_gpdfit <- function(x, u, run = NULL, n_grid = 50,
                                 wip = TRUE, min_grid_pts = 30,
                                 sort_x = FALSE) {
  w <- find_opt_weights(x, u, run, n_grid)
  gpdfit(w$exc, wip, min_grid_pts, sort_x, weights = w$wts)
}

geom_weighted_gpdfit_dens<- function(x, u, run = NULL, n_grid = 50,
                                 wip = TRUE, min_grid_pts = 100,
                                 sort_x = FALSE,rparams=NULL,density=TRUE) {
  w <- find_opt_weights(x, u, run, n_grid)
  gpdfit_dens(w$exc, wip, min_grid_pts, sort_x, weights = w$wts,
                                  rparams=rparams, density=density)
}


