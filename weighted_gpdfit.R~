# -----------------------------------------------------------------------------
# gpdfit()---same function as in the  posterior package :
# Full GPD fit via Zhang-Stephens (2009) profile likelihood.
# Optionally applies a weakly-informative prior on k (wip).
# Returns list(k, sigma).
# -----------------------------------------------------------------------------


gpdfit <- function(x, wip = TRUE, min_grid_pts = 30,
                   sort_x = TRUE, weights = NULL) {
  if (sort_x) {
    if (!is.null(weights)) {
      ord     <- sort.int(x, index.return = TRUE)
      x       <- ord$x
      weights <- weights[ord$ix]
    } else {
      x <- sort.int(x)
    }
  }
  N <- length(x)

  if (!is.null(weights))
    weights <- weights / sum(weights) * N   # normalize to sum = N

  prior <- 3
  M     <- min_grid_pts + floor(sqrt(N))
  jj    <- seq_len(M)
  xstar <- x[floor(N / 4 + 0.5)]           # first quartile

  if (xstar > x[1]) {
    theta     <- 1 / x[N] + (1 - sqrt(M / (jj - 0.5))) / prior / xstar
    log1p_mat <- log1p(-theta %o% x)        # M x N

    k <- if (!is.null(weights))
           drop(log1p_mat %*% weights) / N
         else
           matrixStats::rowMeans2(log1p_mat)

    l_theta   <- N * (log(-theta / k) - k - 1)
    w_theta   <- exp(l_theta - matrixStats::logSumExp(l_theta))
    theta_hat <- sum(theta * w_theta)

    k_hat <- if (!is.null(weights))
               sum(weights * log1p(-theta_hat * x)) / N
             else
               mean.default(log1p(-theta_hat * x))

    sigma_hat <- -k_hat / theta_hat

    if (wip)
      k_hat <- (k_hat * N + 0.5 * 10) / (N + 10)

    if (is.na(k_hat)) { k_hat <- Inf; sigma_hat <- NaN }

  } else {
    k_hat <- NA; sigma_hat <- NA
  }

  list(k = k_hat, sigma = sigma_hat)
}



gpdfit_dens<- function(x, wip = TRUE, min_grid_pts = 100,
                   sort_x = TRUE, weights = NULL,rparams=NULL, density=TRUE) {
  if (sort_x) {
    if (!is.null(weights)) {
      ord     <- sort.int(x, index.return = TRUE)
      x       <- ord$x
      weights <- weights[ord$ix]
    } else {
      x <- sort.int(x)
    }
  }
  N <- length(x)

  if (!is.null(weights))
    weights <- weights / sum(weights) * N   # normalize to sum = N

  prior <- 3
  M     <- min_grid_pts + floor(sqrt(N))
  jj    <- seq_len(M)
  xstar <- x[floor(N / 4 + 0.5)]           # first quartile

  if (xstar > x[1]) {
    theta     <- 1 / x[N] + (1 - sqrt(M / (jj - 0.5))) / prior / xstar
    log1p_mat <- log1p(-theta %o% x)        # M x N

    k <- if (!is.null(weights))
           drop(log1p_mat %*% weights) / N
         else
           matrixStats::rowMeans2(log1p_mat)

    l_theta   <- N * (log(-theta / k) - k - 1)
    w_theta   <- exp(l_theta - matrixStats::logSumExp(l_theta))
    theta_hat <- sum(theta * w_theta)

    k_hat <- if (!is.null(weights))
               sum(weights * log1p(-theta_hat * x)) / N
             else
               mean.default(log1p(-theta_hat * x))

    sigma_hat <- -k_hat / theta_hat

    if (wip)
      k_hat <- (k_hat * N + 0.5 * 10) / (N + 10)

    if (is.na(k_hat)) { k_hat <- Inf; sigma_hat <- NaN }

  } else {
    k_hat <- NA; sigma_hat <- NA
  }

  ## Return level posterior mean (point estimate)
  if (!is.null(rparams)) {
    u   <- rparams$u    # threshold
    m  <- rparams$m    # m-obs return level 
    p_u <- rparams$p_u  # P(X > u)
    # x_p = u + (sigma/k)[(m*p_u)^k - 1], with sigma = -k/theta
    #     = u + (1 - (m*p_u)^k) / theta
    xp_hat <- u + (1 - (m * p_u)^k_hat) / theta_hat
  } else {
    xp_hat <- NA
  }

  if (!density) {
    return(list(k = k_hat, sigma = sigma_hat, xp = xp_hat))
  }

  # ---- posterior density on the theta / k grid ----------------------------
  # Unnormalized posterior: profile likelihood × half-normal prior on theta
  u_post <- w_theta * dgeneralized_pareto(-theta,
                                          mu    = -1 / x[N],
                                          sigma = 1 / prior / xstar,
                                          k     = 0.5)

  # Normalize over k via trapezoidal rule (k is descending in theta order)
  Z_k <- sum((u_post[-M] + u_post[-1]) * (k[-M] - k[-1])) / 2
  k_d <- u_post / Z_k   # posterior density for k

  # ---- posterior density on the return-level grid -------------------------
  if (!is.null(rparams)) {
    # Deterministic map theta -> xp (may not be monotone, so sort)
    xp_grid   <- u + ( 1-(m * p_u)^k) / theta
    #ord        <- order(xp_grid)
    xp_sorted  <- xp_grid #[ord]
    up_sorted  <- u_post #[ord]

   #
     end_idx <- if (any(diff(xp_sorted) >= 0)) which(diff(xp_sorted) >= 0)[1] else length(xp_sorted)
     xp_sorted <- xp_sorted [1:end_idx]
     up_sorted <- up_sorted[1:end_idx]

     Z_xp <- sum((up_sorted[-length(up_sorted)] + up_sorted[-1]) *(xp_sorted[-length(up_sorted)]-xp_sorted[-1])) / 2
    
   # Z_xp <- sum((up_sorted[-M] + up_sorted[-1]) *(xp_sorted[-M]-xp_sorted[-1])) / 2 # diff(xp_sorted)
    xp_d <- up_sorted / Z_xp
  } else {
    xp_sorted <- NA
    xp_d      <- NA
  }

  list(k          = k_hat,
       sigma      = sigma_hat,
       xp         = xp_hat,
       theta_grid = theta,
       k_grid     = k,
       xp_grid    = xp_sorted,
       w_theta    = w_theta,
       k_dens     = k_d,
       xp_dens    = xp_d,
       u_post= u_post)
}




# -----------------------------------------------------------------------------
# crps_gpd_closed()
# Closed-form CRPS for GPD(sigma, xi) evaluated at exceedance y.
# Handles the exponential limit (xi ≈ 0) separately.
# -----------------------------------------------------------------------------
crps_gpd_closed <- function(y, sigma, xi) {
  if (abs(xi) < 1e-6) {
    Fy <- 1 - exp(-y / sigma)
    return(y - sigma * (2 * Fy - 0.5))
  }
  z     <- 1 + xi * y / sigma
  Fy    <- 1 - z^(-1 / xi)
  term1 <- (y + sigma / xi) * (2 * Fy - 1)
  term2 <- (2 * sigma) / (xi * (xi - 1)) *
            (1 / (xi - 2) + (1 - Fy) * (1 + xi * y / sigma))
  term1 - term2
}


# -----------------------------------------------------------------------------
# crps_gpd_posterior()
# Posterior-expected CRPS: averages crps_gpd_closed() over the theta grid
# using posterior weights w_theta. Accepts scalar or vector y.
# -----------------------------------------------------------------------------
crps_gpd_posterior <- function(y, fit) {
  k_grid     <- fit$k_grid
  sigma_grid <- -k_grid / fit$theta
  w_theta    <- fit$w_theta

  crps_grid <- mapply(
    function(sigma_j, k_j) crps_gpd_closed(y, sigma_j, k_j),
    sigma_grid, k_grid
  )
  if (is.vector(y) && length(y) > 1)
    crps_grid <- matrix(crps_grid, nrow = length(y), ncol = length(w_theta))

  if (is.matrix(crps_grid))
    drop(crps_grid %*% w_theta)
  else
    sum(crps_grid * w_theta)
}



# -----------------------------------------------------------------------------
# auto_run_length()
# Data-driven run length for declustering, following
#   Ferro, C. A. T. and Segers, J. (2003) "Inference for clusters of extreme
#   values", JRSS-B 65(2):545-556.
#
# Step 1 — intervals estimator of the extremal index from the N-1
#          interexceedance times T_i (their equations 1-2):
#            max T_i <= 2 :  theta = 2 (sum T_i)^2      / [(N-1) sum T_i^2]
#            max T_i >  2 :  theta = 2 (sum(T_i - 1))^2 / [(N-1) sum (T_i-1)(T_i-2)]
#          The branch matters: for max T_i <= 2 the (T_i-1)(T_i-2) terms are
#          identically zero, so only the first form is defined there.
# Step 2 — C = ceiling(theta * N) clusters are separated by the C-th largest
#          interexceedance times, so runs-declustering reproduces them with
#            r = T_(C)
#          (gaps >= r+1 split clusters, cf. weights_precompute()).
#          Ties: if T_(C-1) == T_(C) the tied gaps are not separated and fewer
#          than C clusters result, so C is decreased until T_(C-1) > T_(C).
#
# Returns an integer run length >= 1.
# -----------------------------------------------------------------------------
auto_run_length <- function(x, u) {

  exc <- which(x > u)
  N   <- length(exc)
  if (N < 3L) return(1L)

  T_int <- diff(exc)                 # N-1 interexceedance times
  nT    <- length(T_int)

  theta <- if (max(T_int) <= 2)
             2 * sum(T_int)^2     / (nT * sum(T_int^2))
           else
             2 * sum(T_int - 1)^2 / (nT * sum((T_int - 1) * (T_int - 2)))
  theta <- if (is.finite(theta)) min(1, theta) else 1

  # C clusters; clamp to nT since only nT = N-1 interexceedance times exist
  C <- min(ceiling(theta * N), nT)
  if (C < 2L) return(as.integer(max(T_int)))       # everything in one cluster

  Ts <- sort(T_int, decreasing = TRUE)

  # Ties: r = T_(C) only cuts gaps strictly greater than T_(C), so if
  # T_(C-1) == T_(C) the tied gaps are not separated and we get fewer than C
  # clusters. Shrink C until T_(C-1) > T_(C); then the C-1 largest gaps are
  # all strictly greater than T_(C) and runs-declustering yields exactly C.
  while (C >= 2L && Ts[C - 1L] == Ts[C]) C <- C - 1L

  if (C < 2L) return(as.integer(max(T_int)))       # all gaps tied
  as.integer(max(1L, Ts[C]))
}


# -----------------------------------------------------------------------------
# weights_precompute()
# Identifies threshold exceedances, detects clusters (run-length r), and
# pre-sorts within-cluster indices by descending excess — all steps
# independent of q, so they run once before any q-grid search.
#
# r = NULL (default) selects the run length automatically via the
# Ferro-Segers (2003) intervals estimator, see auto_run_length().
# Pass r explicitly to override (r = 0 -> every exceedance is its own cluster).
#
# Returns a precompute object consumed by weights_from_precomp().
# -----------------------------------------------------------------------------
weights_precompute <- function(x, u, r = NULL) {

  idx_exceed <- which(x > u)

  if (length(idx_exceed) == 0L) {
    return(list(empty = TRUE, excesses = numeric(0), cluster_id = integer(0),
                K = 0L, cluster_list = list(), r = NA_integer_))
  }

  if (is.null(r)) r <- auto_run_length(x, u)

  gaps        <- diff(idx_exceed)
  cluster_id  <- cumsum(c(TRUE, gaps >= (r + 1L)))
  exceedances <- x[idx_exceed]
  K           <- max(cluster_id)

  cluster_list <- vector("list", K)
  for (k in seq_len(K)) {
    inds <- which(cluster_id == k)
    cluster_list[[k]] <- if (length(inds) > 1L)
      inds[order(exceedances[inds], decreasing = TRUE)]
    else
      inds
  }

  list(empty = FALSE, excesses = exceedances - u,
       cluster_id = cluster_id, K = K, cluster_list = cluster_list, r = r)
}


# -----------------------------------------------------------------------------
# weights_from_precomp()
# Applies decay rate q to the pre-computed cluster structure.
# This is the only step that changes when q varies.
# Returns list(excesses, weights, cluster_id).
# -----------------------------------------------------------------------------
weights_from_precomp <- function(pre, q = 0) {
  if (pre$empty)
    return(list(excesses = numeric(0), weights = numeric(0),
                cluster_id = integer(0)))

  K        <- pre$K
  excesses <- pre$excesses
  weights  <- numeric(length(excesses))

  for (k in seq_len(K)) {
    inds_ord <- pre$cluster_list[[k]]
    m_j      <- length(inds_ord)
    if (m_j == 1L) {
      weights[inds_ord] <- 1 / K
    } else {
      powers            <- q ^ (0L:(m_j - 1L))
      denom             <- if (abs(1 - q) < 1e-6) m_j
                           else (1 - q ^ m_j) / (1 - q)
      weights[inds_ord] <- (1 / K) * powers / denom
    }
  }

  list(excesses = excesses, weights = weights, cluster_id = pre$cluster_id)
}


# -----------------------------------------------------------------------------
# weights_fun()
# One-shot convenience wrapper: compute cluster weights for a single q.
# r = NULL (default) → automatic run length via auto_run_length();
# r = 0 → no clustering (all equal weight);  q = 0 → POT (cluster maxima only).
# Returns list(excesses, weights, cluster_id, r).
# -----------------------------------------------------------------------------
weights_fun <- function(x, u, r = NULL, q = NULL) {
  pre <- weights_precompute(x, u, r)
  out <- weights_from_precomp(pre, q = if (is.null(q)) 0 else q)
  out$r <- pre$r
  out
}


# -----------------------------------------------------------------------------
# profile_post()
# Learn GPD profile posterior used exclusively for CRPS scoring.
# Returns only the three fields needed by crps_gpd_posterior():
# theta (grid), k_grid, w_theta (posterior weights).
# x must arrive sorted ascending; weights pre-normalised or NULL.
# -----------------------------------------------------------------------------
profile_post <- function(x, weights = NULL, min_grid_pts = 30L) {
  N <- length(x)

  if (!is.null(weights))
    weights <- weights / sum(weights) * N

  prior <- 3
  M     <- min_grid_pts + floor(sqrt(N))
  jj    <- seq_len(M)
  xstar <- x[floor(N / 4 + 0.5)]

  if (xstar <= x[1L])
    return(list(theta = NA_real_, k_grid = NA_real_, w_theta = NA_real_))

  theta     <- 1 / x[N] + (1 - sqrt(M / (jj - 0.5))) / prior / xstar
  log1p_mat <- log1p(-theta %o% x)

  k_grid <- if (!is.null(weights))
               drop(log1p_mat %*% weights) / N
             else
               matrixStats::rowMeans2(log1p_mat)

  l_theta <- N * (log(-theta / k_grid) - k_grid - 1)
  w_theta <- exp(l_theta - matrixStats::logSumExp(l_theta))

  list(theta = theta, k_grid = k_grid, w_theta = w_theta)
}


# -----------------------------------------------------------------------------
# find_opt_weights()
# Scans q in [0,1] on an n_grid-point grid.  For each q, computes cluster
# weights, fits the GPD profile posterior, and scores via mean posterior CRPS.
# The minimising q_opt is selected; the corresponding sorted excesses and
# weights are returned, ready to be passed directly to gpdfit().
# run = NULL (default) → automatic run length via auto_run_length().
# -----------------------------------------------------------------------------
find_opt_weights <- function(x, u, run = NULL, n_grid = 50) {
  pre            <- weights_precompute(x, u, r = run)
  exc_sorted_idx <- order(pre$excesses)
  q_span         <- seq(0, 1, length.out = n_grid)

  sc <- vapply(q_span, function(q) {
    w     <- weights_from_precomp(pre, q)
    exc_s <- w$excesses[exc_sorted_idx]
    wts_s <- w$weights[exc_sorted_idx]
    ft    <- profile_post(exc_s, weights = wts_s, min_grid_pts = 30L)
    mean(crps_gpd_posterior(exc_s, ft))
  }, numeric(1))

  q_opt <- q_span[which.min(sc)]
  w_opt <- weights_from_precomp(pre, q_opt)

  list(
    q_span    = q_span,
    scores    = sc,
    q_opt     = q_opt,
    run       = pre$r,
    nclusters = max(pre$cluster_id),
    exc       = w_opt$excesses[exc_sorted_idx],
    wts       = w_opt$weights[exc_sorted_idx]
  )
}

################# quantile & distribution functions of GPD


qgeneralized_pareto <- function(p, mu = 0, sigma = 1, k = 0, lower.tail = TRUE, log.p = FALSE) {
  stopifnot(length(mu) == 1 && length(sigma) == 1 && length(k) == 1)
  if (is.na(sigma) || sigma <= 0) {
    return(rep(NaN, length(p)))
  }
  if (log.p) {
    p <- exp(p)
  }
  if (!lower.tail) {
    p <- 1 - p
  }
  if (k == 0) {
    q <-  mu - sigma * log1p(-p)
  } else {
    q <- mu + sigma * expm1(-k * log1p(-p)) / k
  }
  q
}

dgeneralized_pareto <- function(x, mu = 0, sigma = 1, k = 0, log = FALSE) {
  stopifnot(length(mu) == 1 && length(sigma) == 1 && length(k) == 1)
  if (is.na(sigma) || sigma <= 0) {
    return(rep(NaN, length(x)))
  }
  z <- (x - mu) / sigma
  # Points outside the support have zero density
  if (k >= 0) {
    in_support <- z >= 0
  } else {
    in_support <- z >= 0 & z <= -1 / k
  }
  log_d <- rep(-Inf, length(x))
  z_s   <- z[in_support]
  if (abs(k) < 1e-15) {
    log_d[in_support] <- -log(sigma) - z_s
  } else {
    log_d[in_support] <- -log(sigma) - (1 / k + 1) * log1p(pmax(k * z_s, -1))
  }
  if (log) log_d else exp(log_d)
}

pgeneralized_pareto <- function(q, mu = 0, sigma = 1, k = 0, lower.tail = TRUE, log.p = FALSE) {
  stopifnot(length(mu) == 1 && length(sigma) == 1 && length(k) == 1)
  if (is.na(sigma) || sigma <= 0) {
    return(rep(NaN, length(q)))
  }
  z <- (q - mu) / sigma
  if (abs(k) < 1e-15) {
    # for very small values of indistinguishable in floating point accuracy from the case k=0
    p <- -expm1(-z)
  } else {
    # pmax handles values outside the support
    p <- -expm1(log1p(pmax(k * z, -1)) / -k)
  }
  # force to [0, 1] for values outside the support
  p <- pmin(pmax(p, 0), 1)
  if (!lower.tail) {
    p <- 1 - p
  }
  if (log.p) {
    p <- log(p)
  }
  p
}



# =============================================================================
# plot_k_dens()
#
# Overlay the posterior density of the shape parameter k for the three
# estimation procedures:
#   1. Weighted GPD        — geom_weighted_gpdfit_dens()
#   2. Cluster maxima/POT  — gpdfit_dens() with q = 0
#   3. Conventional        — gpdfit_dens() with r = 0 (equal weights)
#
# ARGUMENTS
#   x            Numeric vector. Raw time series.
#   u            Numeric scalar. Threshold.
#   run          Integer. Run-length for cluster detection.
#   k_true       Optional numeric. True k; draws a vertical reference line.
#   min_grid_pts Integer. Grid resolution passed to gpdfit_dens().
#   n_grid       Integer. q-grid size for geom_weighted_gpdfit_dens().
#   xlim         Optional numeric(2). x-axis limits; auto-detected if NULL.
#   alpha        Numeric in (0,1]. Fill ribbon transparency.
# =============================================================================

plot_k_dens <- function(x, u, run = NULL,
                        k_true       = NULL,
                        min_grid_pts = 200,
                        n_grid       = 50,
                        xlim         = NULL,
                        alpha        = 0.15) {

  stopifnot(requireNamespace("ggplot2", quietly = TRUE))

  # resolve the run length once so all procedures use the same value
  if (is.null(run)) run <- auto_run_length(x, u)

  # --- fit all three procedures --------------------------------------------
  res_weighted <- geom_weighted_gpdfit_dens(x, u, run,
                                            n_grid       = n_grid,
                                            min_grid_pts = min_grid_pts,
                                            wip          = TRUE,
                                            sort_x       = FALSE)

  w_pot    <- weights_fun(x, u, r = run, q = 0)
  res_pot  <- gpdfit_dens(w_pot$excesses, wip = TRUE, sort_x = TRUE,
                          weights = w_pot$weights, min_grid_pts = min_grid_pts)

  w_conv   <- weights_fun(x, u, r = 0)
  res_conv <- gpdfit_dens(w_conv$excesses, wip = TRUE, sort_x = TRUE,
                          weights = w_conv$weights, min_grid_pts = min_grid_pts)

  # --- helper: tidy a fit result into a data.frame -------------------------
  tidy_dens <- function(res, label) {
    ord <- order(res$k_grid)
    data.frame(k = res$k_grid[ord], dens = res$k_dens[ord], method = label)
  }

  df <- rbind(
    tidy_dens(res_weighted, "Weighted GPD"),
    tidy_dens(res_pot,      "Cluster maxima (POT)"),
    tidy_dens(res_conv,     "Conventional")
  )
  df$method <- factor(df$method,
                      levels = c("Weighted GPD", "Cluster maxima (POT)", "Conventional"))

  # --- colour palette -------------------------------------------------------
  pal <- c("Weighted GPD"         = "#2166AC",
           "Cluster maxima (POT)" = "#D6604D",
           "Conventional"         = "#4DAC26")

  # --- x-axis limits (auto: trim near-zero tails) --------------------------
  if (is.null(xlim)) {
    in_range <- is.finite(df$dens) & df$dens > 1e-6 * max(df$dens, na.rm = TRUE)
    xlim <- range(df$k[in_range])
    xlim <- xlim + c(-1, 1) * 0.05 * diff(xlim)
  }

  # --- build plot -----------------------------------------------------------
  p <- ggplot2::ggplot(df, ggplot2::aes(x = k, y = dens,
                                        colour = method, fill = method)) +
    ggplot2::geom_ribbon(ggplot2::aes(ymin = 0, ymax = dens),
                         alpha = alpha, colour = NA) +
    ggplot2::geom_line(linewidth = 0.9) +
    ggplot2::scale_colour_manual(values = pal, name = "Procedure") +
    ggplot2::scale_fill_manual(values = pal,   name = "Procedure") +
    ggplot2::coord_cartesian(xlim = xlim, ylim = c(0, NA), expand = FALSE) +
    ggplot2::labs(
      title    = "Posterior density of the GPD shape parameter k",
      subtitle = sprintf("Threshold u = %.3f  |  run = %d", u, run),
      x        = expression(italic(k)),
      y        = "Posterior density"
    ) +
    ggplot2::theme_bw(base_size = 13) +
    ggplot2::theme(
      legend.position        = "inside",
      legend.position.inside = c(0.97, 0.97),
      legend.justification   = c(1, 1),
      legend.background      = ggplot2::element_rect(fill = "white", colour = "grey80"),
      legend.key.width       = ggplot2::unit(1.5, "cm"),
      panel.grid.minor       = ggplot2::element_blank()
    )

  # optional true-k reference line
  if (!is.null(k_true)) {
    p <- p +
      ggplot2::geom_vline(xintercept = k_true,
                          linetype = "dashed", colour = "grey30", linewidth = 0.7) +
      ggplot2::annotate("text",
                        x      = k_true,
                        y      = Inf,
                        label  = sprintf(" k == %g", k_true),
                        parse  = TRUE,
                        hjust  = 0, vjust = 1.5,
                        colour = "grey30", size = 3.8)
  }

  p
}


# =============================================================================
# plot_xp_dens()
#
# Overlay the posterior density of the m-observation return level xp for the
# three estimation procedures:
#   1. Weighted GPD        — geom_weighted_gpdfit_dens()
#   2. Cluster maxima/POT  — gpdfit_dens() with q = 0
#   3. Conventional        — gpdfit_dens() with r = 0 (equal weights)
#
# ARGUMENTS
#   x            Numeric vector. Raw time series.
#   u            Numeric scalar. Threshold.
#   run          Integer. Run-length for cluster detection.
#   rparams      Named list with fields:
#                  $u    — threshold (same as u above)
#                  $m    — marginal exceedance prob P(X > xp) = 1/m
#                  $p_u  — probability of exceeding u, i.e. P(X > u)
#   xp_true      Optional numeric. True return level; draws a vertical line.
#   min_grid_pts Integer. Grid resolution passed to gpdfit_dens().
#   n_grid       Integer. q-grid size for geom_weighted_gpdfit_dens().
#   xlim         Optional numeric(2). x-axis limits; auto-detected if NULL.
#   alpha        Numeric in (0,1]. Fill ribbon transparency.
# =============================================================================

plot_xp_dens <- function(x, u, rparams, xp_true= NULL,
                         run = NULL,
                         min_grid_pts = 200,
                         n_grid       = 50,
                         xlim         = NULL,
                         alpha        = 0.15) {

  stopifnot(requireNamespace("ggplot2", quietly = TRUE))
  stopifnot(all(c("u", "m", "p_u") %in% names(rparams)))
  m <- rparams$m

  # resolve the run length once so all procedures use the same value
  if (is.null(run)) run <- auto_run_length(x, u)

  # --- fit all three procedures --------------------------------------------
  res_weighted <- geom_weighted_gpdfit_dens(x, u, run,
                                            n_grid       = n_grid,
                                            min_grid_pts = min_grid_pts,
                                            wip          = TRUE,
                                            sort_x       = FALSE,
                                            rparams      = rparams)

  w_pot    <- weights_fun(x, u, r = run, q = 0)
  res_pot  <- gpdfit_dens(w_pot$excesses, wip = TRUE, sort_x = TRUE,
                          weights      = w_pot$weights,
                          min_grid_pts = min_grid_pts,
                          rparams      = rparams)

  w_conv   <- weights_fun(x, u, r = 0)
  res_conv <- gpdfit_dens(w_conv$excesses, wip = TRUE, sort_x = TRUE,
                          weights      = w_conv$weights,
                          min_grid_pts = min_grid_pts,
                          rparams      = rparams)

  # --- helper: tidy a fit result into a data.frame -------------------------
  tidy_dens <- function(res, label) {
    xp   <- res$xp_grid
    dens <- res$xp_dens
    # drop NA / non-finite entries
    ok <- is.finite(xp) & is.finite(dens)
    data.frame(xp = xp[ok], dens = dens[ok], method = label)
  }

  df <- rbind(
    tidy_dens(res_weighted, "Weighted GPD"),
    tidy_dens(res_pot,      "Cluster maxima (POT)"),
    tidy_dens(res_conv,     "Conventional")
  )
  df$method <- factor(df$method,
                      levels = c("Weighted GPD", "Cluster maxima (POT)", "Conventional"))

  # --- colour palette -------------------------------------------------------
  pal <- c("Weighted GPD"         = "#2166AC",
           "Cluster maxima (POT)" = "#D6604D",
           "Conventional"         = "#4DAC26")

  # --- x-axis limits (auto: trim near-zero tails) --------------------------
  if (is.null(xlim)) {
    in_range <- is.finite(df$dens) & df$dens > 1e-6 * max(df$dens, na.rm = TRUE)
    if (any(in_range)) {
      xlim <- range(df$xp[in_range])
    } else {
      xlim <- range(df$xp[is.finite(df$xp)])   # fallback: full finite range
    }
    xlim <- xlim + c(-1, 1) * 0.05 * diff(xlim)
  }

  # --- return period label for subtitle ------------------------------------
  subtitle <- sprintf(
    "Threshold u = %.3f  |  run = %d  |  return period m = %d",
    u, run, m
  )

  # --- build plot -----------------------------------------------------------
  p <- ggplot2::ggplot(df, ggplot2::aes(x = xp, y = dens,
                                        colour = method, fill = method)) +
    ggplot2::geom_ribbon(ggplot2::aes(ymin = 0, ymax = dens),
                         alpha = alpha, colour = NA) +
    ggplot2::geom_line(linewidth = 0.9) +
    ggplot2::scale_colour_manual(values = pal, name = "Procedure") +
    ggplot2::scale_fill_manual(values = pal,   name = "Procedure") +
    ggplot2::coord_cartesian(xlim = xlim, ylim = c(0, NA), expand = FALSE) +
    ggplot2::labs(
      title    = expression("Posterior density of the return level " * italic(x[p])),
      subtitle = subtitle,
      x        = expression(italic(x[p])),
      y        = "Posterior density"
    ) +
    ggplot2::theme_bw(base_size = 13) +
    ggplot2::theme(
      legend.position        = "inside",
      legend.position.inside = c(0.97, 0.97),
      legend.justification   = c(1, 1),
      legend.background      = ggplot2::element_rect(fill = "white", colour = "grey80"),
      legend.key.width       = ggplot2::unit(1.5, "cm"),
      panel.grid.minor       = ggplot2::element_blank()
    )

  # optional true return-level reference line
  if (!is.null(xp_true)) {
    p <- p +
      ggplot2::geom_vline(xintercept = xp_true,
                          linetype = "dashed", colour = "grey30", linewidth = 0.7) +
      ggplot2::annotate("text",
                        x      = xp_true,
                        y      = Inf,
                        label  = sprintf(" x[p] == %g", xp_true),
                        parse  = TRUE,
                        hjust  = 0, vjust = 1.5,
                        colour = "grey30", size = 3.8)
  }

  p
}


