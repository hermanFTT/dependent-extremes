# =============================================================================
# pitman_closeness()
#
# Estimate the Pitman closeness criterion for the GPD shape parameter:
#
#   P_k( |T1 - k| < |T2 - k| )
#
# T1 (the "challenger") and T2 (the "baseline") are each freely chosen from
#
#   "Weighted GPD"          – CRPS-optimal geometric weights
#   "Cluster maxima (POT)"  – q = 0, all weight on the cluster maximum
#   "Conventional"          – r = 0, equal weights on every excess
#
# For each true shape value on a grid, S dependent-series replicates are
# generated; both estimators are fitted to each *same* sample.
# Ties (|T1-k| == |T2-k|) contribute 0.5 to T1's score.
#
# Arguments:
#   k_grid      numeric vector of true shape values to evaluate (default: 30
#               equally-spaced points in [-0.5, 0.5])
#   S           number of Monte-Carlo replicates per grid point
#   n           series length
#   dep         dependence structure: "ar1" or "markov"
#   phi         AR(1) correlation (dep = "ar1")
#   alpha       Markov dependence strength (dep = "markov")
#   dep_model   bivariate EV copula model (dep = "markov")
#   sigma       true GPD scale (fixed at 1 by default)
#   p_thresh    probability level defining the threshold
#   threshold   "theoretical" (quantile of GPD) or "empirical" (sample quantile)
#   run         run length for declustering; NULL → auto_run_length() per rep
#   n_grid      grid size for the profile-posterior of k  (gpdfit_dens)
#   min_grid_pts minimum grid points for gpdfit
#   wip         weakly-informative prior correction in gpdfit
#   t1          "T1" (challenger) procedure; one of "Weighted GPD",
#               "Cluster maxima (POT)", "Conventional"
#   t2          "T2" (baseline) procedure; same choices, must differ from t1
#   seed        master RNG seed.  One independent L'Ecuyer-CMRG substream is
#               assigned per replicate, so results are bit-identical no matter
#               how many cores are used.
#   ncores      number of cores for the replicate loop within each grid point
#               (1 = serial; NULL/NA = detectCores() - 1).  Uses forking, so
#               it falls back to serial on Windows.
#   verbose     print progress?
#
# Returns a data.frame with one row per grid point:
#   k_true     – the true shape value
#   p_hat      – estimated P_k(T1 closer than T2)  [0, 1]
#   se         – Monte-Carlo standard error sqrt(p*(1-p)/n_ok)
#   n_wins     – number of replicates where T1 strictly won
#   n_ties     – number of ties
#   n_ok       – replicates where both fits succeeded
#   rmse_t1    – root-mean-square error of T1 at this k
#   rmse_t2    – root-mean-square error of T2 at this k
#   bias_t1    – mean(T1 - k)
#   bias_t2    – mean(T2 - k)
#   rmse_ratio – rmse_t1 / rmse_t2   (< 1 → T1 has lower RMSE)
# =============================================================================
pitman_closeness <- function(
    k_grid       = seq(-0.5, 0.5, length.out = 30),
    S            = 100L,
    n            = 2000L,
    dep          = c("ar1", "markov"),
    phi          = 0.95,
    alpha        = 0.5,
    dep_model    = "log",
    sigma        = 1,
    p_thresh     = 0.95,
    threshold    = c("theoretical", "empirical"),
    run          = NULL,
    n_grid       = 50L,
    min_grid_pts = 100L,
    wip          = FALSE,
    t1           = c("Weighted GPD", "Cluster maxima (POT)", "Conventional"),
    t2           = c("Conventional", "Cluster maxima (POT)", "Weighted GPD"),
    seed         = 1L,
    ncores       = 1L,
    verbose      = TRUE) {

  dep       <- match.arg(dep)
  threshold <- match.arg(threshold)
  t1        <- match.arg(t1)
  t2        <- match.arg(t2)

  if (identical(t1, t2))
    stop("`t1` and `t2` must be two different procedures.")

  if (dep == "markov")
    stopifnot(requireNamespace("POT", quietly = TRUE))

  # --- parallel back-end ----------------------------------------------------
  # Replicates *within* each grid point are distributed over `ncores`.
  # ncores = NULL / NA  ->  detectCores() - 1
  if (is.null(ncores) || is.na(ncores))
    ncores <- max(1L, parallel::detectCores() - 1L)
  ncores <- max(1L, min(as.integer(ncores), S))
  # forking is Unix-only; fall back to serial elsewhere
  if (ncores > 1L && .Platform$OS.type == "windows") {
    warning("Forking unavailable on Windows; running serially.", call. = FALSE)
    ncores <- 1L
  }
  parallel_run <- ncores > 1L

  n_k <- length(k_grid)

  # --- shape-estimator dispatcher -------------------------------------------
  # Returns the shape estimate k_hat for procedure `proc` on series `x`
  # above threshold `u` with run length `run_s`; NA on failure.
  fit_k <- function(proc, x, u, run_s) {
    tryCatch(switch(
      proc,
      "Weighted GPD" =
        geom_weighted_gpdfit_dens(x, u, run_s,
                                  n_grid       = n_grid,
                                  min_grid_pts = min_grid_pts,
                                  wip          = wip,
                                  sort_x       = FALSE,
                                  density      = FALSE)$k,
      "Cluster maxima (POT)" = {
        w <- weights_fun(x, u, r = run_s, q = 0)
        gpdfit(w$excesses, wip = wip, min_grid_pts = min_grid_pts,
               sort_x = TRUE, weights = w$weights)$k
      },
      "Conventional" = {
        w <- weights_fun(x, u, r = 0L)
        gpdfit(w$excesses, wip = wip, min_grid_pts = min_grid_pts,
               sort_x = TRUE, weights = w$weights)$k
      }
    ), error = function(e) NA_real_)
  }

  # Pre-allocate output storage
  out <- data.frame(
    k_true     = k_grid,
    p_hat      = NA_real_,
    se         = NA_real_,
    n_wins     = NA_integer_,
    n_ties     = NA_integer_,
    n_ok       = NA_integer_,
    rmse_t1    = NA_real_,
    rmse_t2    = NA_real_,
    bias_t1    = NA_real_,
    bias_t2    = NA_real_,
    rmse_ratio = NA_real_    # rmse_t1 / rmse_t2  (< 1 → T1 better)
  )

  # --- one Monte-Carlo replicate --------------------------------------------
  # Returns c(ok, score, d1, d2).  `stream` is a L'Ecuyer-CMRG seed vector so
  # that every replicate draws from its own independent RNG substream - the
  # result is therefore identical regardless of `ncores` or scheduling order.
  one_rep <- function(stream, k_i, u_th) {

    assign(".Random.seed", stream, envir = globalenv())

    x <- sim_series(n, dep = dep, phi = phi, alpha = alpha,
                    model = dep_model, mu = 0, sigma = sigma, k = k_i)

    u <- if (threshold == "theoretical") u_th
         else as.numeric(stats::quantile(x, probs = p_thresh))

    run_s <- if (is.null(run)) auto_run_length(x, u) else run

    # --- fit both procedures to the SAME sample ---------------------------
    k_t1 <- fit_k(t1, x, u, run_s)
    k_t2 <- fit_k(t2, x, u, run_s)

    if (!is.finite(k_t1) || !is.finite(k_t2))
      return(c(0, 0, 0, 0))

    e1 <- k_t1 - k_i
    e2 <- k_t2 - k_i
    sc <- if (abs(e1) < abs(e2)) 1 else if (abs(e1) > abs(e2)) 0 else 0.5

    c(1, sc, e1, e2)
  }

  # --- independent RNG substreams, one per replicate -------------------------
  # Built once up-front from the master seed; grid point i uses streams
  # ((i-1)*S + 1) ... (i*S).  Guarantees reproducibility across core counts.
  old_kind <- RNGkind("L'Ecuyer-CMRG")
  on.exit(RNGkind(old_kind[1L]), add = TRUE)
  set.seed(seed, kind = "L'Ecuyer-CMRG")
  streams <- vector("list", n_k * S)
  streams[[1L]] <- .Random.seed
  for (j in seq_len(n_k * S - 1L))
    streams[[j + 1L]] <- parallel::nextRNGStream(streams[[j]])

  t_start <- Sys.time()
  if (verbose)
    cat(sprintf("Pitman closeness: %s vs %s | %d grid points x S = %d reps | %s\n",
                t1, t2, n_k, S,
                if (parallel_run) paste0(ncores, " cores") else "serial"))

  for (i in seq_len(n_k)) {

    k_i  <- k_grid[i]
    u_th <- qgeneralized_pareto(p_thresh, mu = 0, sigma = sigma, k = k_i)

    str_i <- streams[seq_len(S) + (i - 1L) * S]

    res <- if (parallel_run)
      parallel::mclapply(str_i, one_rep, k_i = k_i, u_th = u_th,
                         mc.cores = ncores, mc.preschedule = TRUE)
    else
      lapply(str_i, one_rep, k_i = k_i, u_th = u_th)

    # any worker that crashed outright -> treat as a failed replicate
    bad <- !vapply(res, function(z) is.numeric(z) && length(z) == 4L, logical(1))
    if (any(bad)) res[bad] <- list(c(0, 0, 0, 0))

    R <- matrix(unlist(res, use.names = FALSE), nrow = 4L)   # 4 x S
    ok    <- R[1L, ] == 1
    score <- R[2L, ]
    d1    <- R[3L, ]
    d2    <- R[4L, ]

    n_ok_i   <- sum(ok)
    score_ok <- score[ok]
    p_i      <- if (n_ok_i > 0L) mean(score_ok) else NA_real_
    se_i     <- if (n_ok_i > 1L) sqrt(p_i * (1 - p_i) / n_ok_i) else NA_real_

    out$p_hat[i]  <- p_i
    out$se[i]     <- se_i
    out$n_wins[i] <- sum(score_ok == 1)
    out$n_ties[i] <- sum(score_ok == 0.5)
    out$n_ok[i]   <- n_ok_i

    # --- RMSE / bias for both procedures at this grid point ----------------
    if (n_ok_i > 0L) {
      e1 <- d1[ok]; e2 <- d2[ok]
      r1 <- sqrt(mean(e1^2)); r2 <- sqrt(mean(e2^2))
      out$rmse_t1[i]    <- r1
      out$rmse_t2[i]    <- r2
      out$bias_t1[i]    <- mean(e1)
      out$bias_t2[i]    <- mean(e2)
      out$rmse_ratio[i] <- r1 / r2
    }

    if (verbose) {
      el <- as.numeric(difftime(Sys.time(), t_start, units = "secs"))
      cat(sprintf(paste0("  grid point %d / %d  (k = %6.3f)  P_hat = %.3f ",
                         "[SE = %.3f]   RMSE: %.4f vs %.4f   ",
                         "[%.1f min elapsed, ~%.1f min left]\n"),
                  i, n_k, k_i, p_i, se_i, out$rmse_t1[i], out$rmse_t2[i],
                  el / 60, el / 60 * (n_k - i) / i))
      utils::flush.console()
    }
  }

  attr(out, "t1")     <- t1
  attr(out, "t2")     <- t2
  attr(out, "ncores") <- ncores
  attr(out, "S")   <- S
  attr(out, "n")   <- n
  attr(out, "dep") <- list(type = dep, phi = phi, alpha = alpha,
                            model = dep_model)
  out
}


# =============================================================================
# plot_pitman_closeness()
#
# Line plot of estimated Pitman closeness probabilities over a shape grid.
#
# Arguments:
#   pc       data.frame returned by pitman_closeness()
#   se_band  logical: shade a ±1 SE band?
#   t1_label label for the T1 (challenger) estimator  (NULL → from attr)
#   t2_label label for the T2 (baseline) estimator    (NULL → from attr)
#   title    plot title  (NULL → auto-generated)
# =============================================================================
plot_pitman_closeness <- function(pc,
                                  se_band  = TRUE,
                                  t1_label = NULL,
                                  t2_label = NULL,
                                  title    = NULL) {

  stopifnot(requireNamespace("ggplot2", quietly = TRUE))

  t1 <- if (!is.null(t1_label)) t1_label else attr(pc, "t1") %||% "T1"
  t2 <- if (!is.null(t2_label)) t2_label else attr(pc, "t2") %||% "T2"
  S  <- attr(pc, "S")
  n  <- attr(pc, "n")

  dep_info <- attr(pc, "dep")
  dep_lab  <- if (!is.null(dep_info)) {
    if (dep_info$type == "ar1")
      sprintf("AR(1), phi = %g", dep_info$phi)
    else
      sprintf("Markov %s, alpha = %g", dep_info$model, dep_info$alpha)
  } else ""

  auto_title <- if (!is.null(title)) title else
    sprintf("Pitman closeness: %s vs %s\nS = %d, n = %d, %s",
            t1, t2, S %||% "?", n %||% "?", dep_lab)

  # Determine winning regions for annotation
  pc_ok  <- pc[is.finite(pc$p_hat), ]
  winner <- ifelse(pc_ok$p_hat >= 0.5, t1, t2)

  p <- ggplot2::ggplot(pc_ok, ggplot2::aes(x = k_true, y = p_hat)) +
    ggplot2::geom_hline(yintercept = 0.5, linetype = "dashed",
                        colour = "grey40", linewidth = 0.6)

  if (se_band && all(is.finite(pc_ok$se))) {
    p <- p + ggplot2::geom_ribbon(
      ggplot2::aes(ymin = p_hat - se, ymax = p_hat + se),
      fill = "#2166AC", alpha = 0.15)
  }

  p <- p +
    ggplot2::geom_line(colour = "#2166AC", linewidth = 0.9) +
    ggplot2::geom_point(colour = "#2166AC", size = 1.8) +
    ggplot2::annotate("text", x = min(pc_ok$k_true), y = 0.52,
                      label = sprintf("%s winning \u2191", t1),
                      hjust = 0, vjust = 0, size = 3.2, colour = "grey30") +
    ggplot2::annotate("text", x = min(pc_ok$k_true), y = 0.48,
                      label = sprintf("%s winning \u2193", t2),
                      hjust = 0, vjust = 1, size = 3.2, colour = "grey30") +
    ggplot2::labs(title = auto_title,
                  x     = "True shape  k",
                  y     = bquote(hat(P)[k](T[1] ~ closer ~ than ~ T[2]))) +
    ggplot2::theme_bw(base_size = 12) +
    ggplot2::theme(panel.grid.minor  = ggplot2::element_blank(),
                   plot.title        = ggplot2::element_text(size = 11))

  p
}


# =============================================================================
# plot_pitman_rmse()
#
# RMSE of both estimators as a function of the true shape value, from the
# same simulation output produced by pitman_closeness().
#
# Arguments:
#   pc       data.frame returned by pitman_closeness()
#   ratio    logical: if TRUE plot the RMSE *ratio* (T1 / T2) on a log scale
#            with a reference line at 1 instead of the two raw RMSE curves
#   t1_label label for T1  (NULL → from attr)
#   t2_label label for T2  (NULL → from attr)
#   title    plot title    (NULL → auto-generated)
# =============================================================================
plot_pitman_rmse <- function(pc,
                             ratio    = FALSE,
                             t1_label = NULL,
                             t2_label = NULL,
                             title    = NULL) {

  stopifnot(requireNamespace("ggplot2", quietly = TRUE))
  if (is.null(pc$rmse_t1))
    stop("`pc` has no RMSE columns - re-run pitman_closeness().")

  t1 <- if (!is.null(t1_label)) t1_label else attr(pc, "t1") %||% "T1"
  t2 <- if (!is.null(t2_label)) t2_label else attr(pc, "t2") %||% "T2"
  S  <- attr(pc, "S")
  n  <- attr(pc, "n")

  dep_info <- attr(pc, "dep")
  dep_lab  <- if (!is.null(dep_info)) {
    if (dep_info$type == "ar1")
      sprintf("AR(1), phi = %g", dep_info$phi)
    else
      sprintf("Markov %s, alpha = %g", dep_info$model, dep_info$alpha)
  } else ""

  sub_lab <- sprintf("S = %s, n = %s, %s", S %||% "?", n %||% "?", dep_lab)

  # ---------------------------------------------------------------- ratio ---
  if (ratio) {
    d <- pc[is.finite(pc$rmse_ratio), ]
    return(
      ggplot2::ggplot(d, ggplot2::aes(x = k_true, y = rmse_ratio)) +
        ggplot2::geom_hline(yintercept = 1, linetype = "dashed",
                            colour = "grey40", linewidth = 0.6) +
        ggplot2::geom_line(colour = "#2166AC", linewidth = 0.9) +
        ggplot2::geom_point(colour = "#2166AC", size = 1.8) +
        ggplot2::scale_y_continuous(transform = "log2") +
        ggplot2::labs(
          title    = title %||% sprintf("RMSE ratio: %s / %s", t1, t2),
          subtitle = paste0(sub_lab, "   (below 1 \u2192 ", t1, " has lower RMSE)"),
          x        = "True shape  k",
          y        = "RMSE ratio  (log scale)") +
        ggplot2::theme_bw(base_size = 12) +
        ggplot2::theme(panel.grid.minor = ggplot2::element_blank(),
                       plot.title       = ggplot2::element_text(size = 11))
    )
  }

  # ------------------------------------------------------------ two curves ---
  long <- rbind(
    data.frame(k_true = pc$k_true, rmse = pc$rmse_t1, procedure = t1),
    data.frame(k_true = pc$k_true, rmse = pc$rmse_t2, procedure = t2)
  )
  long <- long[is.finite(long$rmse), ]
  long$procedure <- factor(long$procedure, levels = c(t1, t2))

  ggplot2::ggplot(long, ggplot2::aes(x = k_true, y = rmse,
                                     colour = procedure, shape = procedure)) +
    ggplot2::geom_line(linewidth = 0.9) +
    ggplot2::geom_point(size = 1.8) +
    ggplot2::scale_colour_manual(values = stats::setNames(
      c("#2166AC", "#D6604D"), c(t1, t2))) +
    ggplot2::labs(title    = title %||% sprintf("RMSE of shape k: %s vs %s", t1, t2),
                  subtitle = sub_lab,
                  x        = "True shape  k",
                  y        = "RMSE",
                  colour   = NULL, shape = NULL) +
    ggplot2::theme_bw(base_size = 12) +
    ggplot2::theme(legend.position  = "top",
                   panel.grid.minor = ggplot2::element_blank(),
                   plot.title       = ggplot2::element_text(size = 11))
}





