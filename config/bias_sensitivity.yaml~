# =============================================================================
# Configuration for the bias / RMSE / coverage sensitivity experiment.
#
#   snakemake -s bias_sensitivity.smk --cores 16
#
# EVERY varied quantity is a LIST, so a single value and a grid are written the
# same way:   n_obs: [4000]      or      n_obs: [1000, 4000, 8000]
# The workflow runs one job per element of the cartesian product
#   dep_par x k_grid x n_obs x run_len
#
# NB: config keys must be >= 2 characters, otherwise `--config <key>=<value>`
# is rejected by snakemake (its validator is /[a-zA-Z_][\w-]*\w$/).
# =============================================================================

# --- dependence structure ---------------------------------------------------
# ONE type per run (per the task description):
#
#   dep_type   parameter   suggested grid   low end            high end
#   --------   ---------   --------------   ----------------   ----------------
#   "ar1"      phi         (0.1 , 0.98)     ~independence      total dependence
#   "log"      alpha       (0.1 , 0.98)     total dependence   ~independence
#   "nlog"     alpha       (0.1 , 30)       total independence some dependence
dep_type: "log"
dep_par:  [0.1, 0.3, 0.5, 0.7, 0.98]

# --- varied experimental factors -------------------------------------------
k_grid:  [-0.4, -0.2, 0.0, 0.2, 0.4]     # true shape
n_obs:   [1000, 4000, 8000, 12000, 20000] # series length
run_len: ["auto"]                         # "auto" or integers, e.g. [5, 10, 20]

# --- Monte-Carlo ------------------------------------------------------------
n_rep: 1000          # S -- replicates per cell
seed:  20250         # master seed (each cell derives its own from this)
m_ret: 1000          # return period m for the return level z_m

# --- GPD margin / threshold -------------------------------------------------
sigma:     1.0       # true GPD scale (fixed at 1)
p_thresh:  0.95      # threshold = 95th percentile of the margin
threshold: "empirical"   # "empirical" or "theoretical"

# --- coverage ---------------------------------------------------------------
coverage:  true      # compute coverage for k and z_m (costs ~2x runtime)
cred_mass: 0.95      # nominal level
interval:  "hpd"     # "hpd" or "eti"
n_draws:   10000

# --- approaches compared ----------------------------------------------------
# any subset of: Conventional, Weighted GPD, Cluster maxima (POT)
approaches: "Conventional,Weighted GPD,Cluster maxima (POT)"

# --- fitting options --------------------------------------------------------
n_grid:       50     # q-grid size for the CRPS-optimal weights
min_grid_pts: 100
wip:          false  # weakly-informative prior on k

# --- resources --------------------------------------------------------------
# Cores used WITHIN one cell. Keep at 1 and let snakemake run many cells at
# once; raise only when there are fewer cells than cores.
threads_per_job: 1

# --- figures ----------------------------------------------------------------
fig_device: "pdf"
fig_dpi:    130
# value each dimension is filtered to in plots that cannot show it;
# "" means "use the middle value present in the data"
fix_k:   ""
fix_dep: ""
fix_r:   ""
