# =============================================================================
# Configuration for the Pitman-closeness / relative-efficiency experiment.
# Edit here, then re-run:  snakemake --cores 16
# =============================================================================

# --- grid of true shape values ----------------------------------------------
n_k:   20            # number of grid points (= number of parallel jobs)
k_min: -0.5
k_max:  0.5

# --- Monte-Carlo ------------------------------------------------------------
S:     1000          # replicates per grid point
n:     2000          # length of each simulated series
seed:  4415          # master seed (grid point i uses seed + i - 1)

# --- dependence structure ---------------------------------------------------
dep:       "markov"  # "ar1" or "markov"
phi:       0.95      # AR(1) coefficient        (used when dep = "ar1")
alpha:     0.35      # Markov dependence        (used when dep = "markov")
dep_model: "log"     # bivariate EV copula      (used when dep = "markov")

# --- GPD margin / threshold -------------------------------------------------
sigma:     1.0       # true GPD scale (fixed at 1 per the task)
p_thresh:  0.95      # threshold probability level
threshold: "empirical"   # "empirical" or "theoretical"

# --- estimators being compared ----------------------------------------------
# one of: "Weighted GPD", "Cluster maxima (POT)", "Conventional"
t1: "Weighted GPD"   # challenger  (wins when P > 0.5 and e > 1)
t2: "Conventional"   # baseline

# --- fitting options --------------------------------------------------------
run:          null   # null -> auto_run_length() per replicate; or an integer
n_grid:       50     # q-grid size for the CRPS-optimal weights
min_grid_pts: 100
wip:          false  # weakly-informative prior on k

# --- resources --------------------------------------------------------------
# Cores used WITHIN one grid point. Keep at 1 and let Snakemake run many grid
# points at once (best throughput); raise only if n_k < available cores.
threads_per_job: 1

# --- figures ----------------------------------------------------------------
fig_device: "png"
fig_dpi:    130
